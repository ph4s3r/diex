{
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Debug with no bytecode",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder}/main.py",
        "console": "integratedTerminal",
        "env": {
          "PYTHONDONTWRITEBYTECODE": "1" // no bytecode thanks
        },
        "args": [],
        "justMyCode": true
      }
    ]
  }
  